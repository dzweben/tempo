# TEMPO — environment template.
# Copy to .env.local and fill in. NEVER commit a filled-in copy.

# --- Survey database (REDCap-compatible REST API) ---
REDCAP_API_URL=https://YOUR-INSTITUTION.edu/redcap/api/
REDCAP_API_TOKEN=
# Saved-report IDs used for completion status, as JSON keyed by wave:
# {"1":{"ema":1001,"atHome":1002},"2":{"ema":2001,"atHome":2002}}
COMPLETION_REPORT_IDS=

# --- Messaging provider (SMS; OpenPhone-compatible REST API) ---
QUO_API_KEY=
QUO_FROM_NUMBER=+15555550100

# --- Email (SMTP; app password or any SMTP account) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Dashboard auth ---
DASHBOARD_PASSWORD=
COOKIE_SECRET=

# --- Private data repository (JSON snapshots + ledgers) ---
# Scoped token with contents read/write on the DATA repo only.
GITHUB_REPOSITORY=YOUR-GITHUB-ORG/YOUR-DATA-REPO
GITHUB_DATA_TOKEN=

# --- Scheduled-route auth ---
# Shared secret for cron-invoked routes; set CRON_SECRET to the same value.
SWEEP_SECRET=
CRON_SECRET=

# --- Optional: coordinator-maintained visit spreadsheet ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# --- Behavior ---
# Kill switch: true = transmit, anything else = dry run.
SEND_LIVE=false
# Sender safety cap per invocation.
MAX_SENDS_PER_RUN=1500
# Refresh route mode: shadow (diff only) or live (write back).
REFRESH_MODE=shadow

# --- Test/debug only (leave unset in production) ---
# DRY_RUN=true
# RECOVERY=false
# AUDIT_DATE=
